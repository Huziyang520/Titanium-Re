{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "${mod_id}.png",
  "contact": {
    "homepage": "${mod_display_url}",
    "sources": "${mod_sources_url}",
    "issues": "${mod_issue_tracker_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.hrznstudio.titanium.fabric.TitaniumFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=${java_version}"
  },
  "custom": {
    "modmenu": {
      "parent": "functionalstorage",
      "badges": [
        "library"
      ],
      "links": {
        "modmenu.titanium.feedback": "https://github.com/Huziyang520/Titanium-Re/issues",
        "modmenu.titanium.backup_feedback": "https://issue.mengcai.online/"
      }
    }
  }
}
